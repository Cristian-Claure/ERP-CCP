# =====================================================================
# CCP — single environment file shared by docker compose and all apps.
# Copy to .env (`make env` does it and fills the secrets for you).
# Never commit .env.
# =====================================================================

# ---- Published ports (host side) -----------------------------------
API_PORT=8000
WEB_PORT=5173
DB_FORWARD_PORT=5432
REDIS_FORWARD_PORT=6379
AI_FORWARD_PORT=8001
MAILPIT_UI_PORT=8025

# ---- Laravel (apps/api) --------------------------------------------
APP_NAME=CCP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ccp
DB_USERNAME=ccp
DB_PASSWORD=ccp_dev_password

# ---- SPA authentication (Sanctum, cookie based) --------------------
# Dev: host-only cookie for "localhost" (null). Prod: ".yourdomain.com"
SESSION_DOMAIN=null
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# Comma separated host[:port] values that receive stateful (cookie) auth.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
# Comma separated origins allowed by CORS (scheme + host + port).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@ccp.test
MAIL_FROM_NAME=CCP

# ---- Internal AI service (apps/ai) ---------------------------------
# Shared secret between Laravel and FastAPI (sent as X-Service-Token).
AI_SERVICE_URL=http://ai:8000
AI_SERVICE_TOKEN=
AI_SERVICE_TIMEOUT=5
AI_LOG_LEVEL=info
# Dev only: expose /docs and /openapi.json without token (http://localhost:8001/docs).
AI_DOCS_ENABLED=true

# ---- Frontend (apps/web) -------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_APP_VERSION=0.1.0-beta
# Map tiles (Leaflet). Default: OpenStreetMap, which requires visible attribution and forbids bulk
# downloads/prefetch (https://operations.osmfoundation.org/policies/tiles/). Change the provider or
# point to self-hosted tiles here; leave empty to use the default.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
